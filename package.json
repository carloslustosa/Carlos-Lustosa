{
  "name": "osc-landing-page",
  "version": "1.0.0",
  "private": true,
  "description": "Site da OSC Gestão Empresarial e Licitações — HTML, CSS e JavaScript, com Tailwind compilado e fontes hospedadas no próprio site.",
  "keywords": [
    "osc",
    "licitacoes",
    "gestao-empresarial",
    "landing-page",
    "site-estatico"
  ],
  "homepage": "https://oscgestao.com.br/",
  "license": "UNLICENSED",
  "author": "OSC Gestão Empresarial e Licitações <contato.osc.gestao@gmail.com>",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run build:css && npm run build:single",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.src.css -o assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.src.css -o assets/css/tailwind.css --watch",
    "build:single": "python3 build.py"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "tailwindcss": "^3.4.17"
  }
}

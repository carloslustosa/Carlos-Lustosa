# ==========================================================================
# OSC — variáveis de ambiente do servidor
# --------------------------------------------------------------------------
# Copie para .env (ou cadastre no painel da Hostinger) e preencha.
# O .env NÃO vai para o repositório: está no .gitignore.
# ==========================================================================

# Chave da API do Gemini, do Google AI Studio.
# Ela move as duas ferramentas de IA: o relatório e o consultor em conversa.
# Fica só aqui, no servidor — nunca no HTML, nunca no JavaScript da página.
GEMINI_API_KEY=

# Modelo usado. Troque se a sua conta não tiver acesso a este.
GEMINI_MODEL=gemini-2.5-flash

# Quantos RELATÓRIOS completos cada visitante pode gerar por hora.
# É uma chamada cara e de tiro único, então o número é baixo.
LIMITE_POR_IP=5

# Quantas MENSAGENS cada visitante pode trocar com o consultor por hora.
# Conversa precisa de folga: com 5, a pessoa seria cortada no meio do
# diagnóstico. As duas cotas são contadas separadamente.
LIMITE_CONSULTOR_POR_IP=30

# Teto de chamadas de IA por hora no site inteiro, somando as duas — protege
# a sua cota do Google
LIMITE_GLOBAL=400

# Porta. Na Hostinger isso é definido pela plataforma; deixe em branco.
# PORT=3000

# --------------------------------------------------------------------------
# CONTAS DE CLIENTE (cadastro, login e perfil)
# --------------------------------------------------------------------------
# Mesmo projeto Supabase usado pelos leads. Rode database/002-contas.sql antes.
# Settings → API no painel do Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Deixe 1 em produção (HTTPS). Só use 0 para testar em http://localhost.
COOKIE_SEGURO=1

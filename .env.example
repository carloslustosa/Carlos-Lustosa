# ==========================================================================
# OSC — variáveis de ambiente do servidor
# --------------------------------------------------------------------------
# Copie para .env (ou cadastre no painel da Hostinger) e preencha.
# O .env NÃO vai para o repositório: está no .gitignore.
# ==========================================================================

# Chave da API do Gemini, do Google AI Studio.
# É ela que gera o diagnóstico. Fica só aqui, no servidor — nunca no HTML.
GEMINI_API_KEY=

# Modelo usado. Troque se a sua conta não tiver acesso a este.
GEMINI_MODEL=gemini-2.5-flash

# Quantos diagnósticos cada visitante pode gerar por hora
LIMITE_POR_IP=5

# Teto de diagnósticos por hora no site inteiro — protege a sua cota
LIMITE_GLOBAL=200

# Porta. Na Hostinger isso é definido pela plataforma; deixe em branco.
# PORT=3000
